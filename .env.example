# Copy to .env. Never commit .env or actual API keys.
HOST=127.0.0.1
PORT=3001
AUTH_REQUIRED=false
TRAVEL_AGENT_PROVIDER=google
TRAVEL_AGENT_MODEL=gemini-2.5-flash
TRAVEL_AGENT_DATA_DIR=./travel-data
USE_STAGEHAND=0
TRAVEL_AGENT_MESSAGE_TIMEOUT_MS=360000
SEARCH_TIMEOUT_MS=12000
IMAGE_TIMEOUT_MS=15000
# Add the user's Gemini key in the browser. Optional local server key:
# GEMINI_API_KEY=
# Required image provider:
# SEARXNG_BASE_URL=https://your-search-service

# Production: set all of these in the hosting service's environment.
# NODE_ENV=production
# HOST=0.0.0.0
# AUTH_REQUIRED=true
# AUTH_COOKIE_SECURE=true
# AUTH_SESSION_SECRET=<random value, at least 32 characters>
# CREDENTIAL_ENCRYPTION_SECRET=<different random value, at least 32 characters>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-app.example/api/auth/callback
# CORS_ORIGINS=https://your-app.example
# ALPHA_USER_ALLOWLIST=invited@example.com
# TRAVEL_AGENT_DATA_DIR=/data
